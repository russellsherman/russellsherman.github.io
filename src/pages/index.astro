---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE_DESCRIPTION, SITE_TAGLINE, SITE_TITLE, formatDate } from '../consts';

// R3.1 — the Person and WebSite nodes are emitted by BaseLayout on every
// page, so the home page needs no extra JSON-LD to satisfy this.

/*
 * The writing index *is* the home page. `/blog/` stays alive as a redirect
 * (see `redirects` in astro.config.mjs) so already-indexed links and inbound
 * links still land somewhere real rather than on the 404.
 */
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  heading={SITE_TITLE}
  tagline={SITE_TAGLINE}
  showSocial={true}
>
  {
    posts.length > 0 ? (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <article>
              <div class="post-meta">
                {/* R2.1 — h2 under the page h1, no level skipped. */}
                <h2 class="post-title">
                  <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="post-date">
                  <Icon name="calendar" />
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </p>
              </div>
              <p>{post.data.description}</p>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <p class="prose">No posts yet.</p>
    )
  }
</BaseLayout>
