---
import { Image } from 'astro:assets';

import SocialLinks from '../components/SocialLinks.astro';
import JsonLd from '../components/JsonLd.astro';
import type { JsonLdNode } from '../lib/schema';
import { SITE_TITLE, SITE_URL } from '../consts';
import hero from '../assets/umeda_sky.jpeg';

import '../styles/global.css';

interface Props {
  /** <title> and OG title. Must be unique across the site (R2.4). */
  title: string;
  /** <meta name="description">. Must be unique across the site (R2.4). */
  description: string;
  /** The single <h1> for this page (R2.1). Rendered in the hero. */
  heading: string;
  /** Optional line under the heading. */
  tagline?: string;
  /** Optional lede under the tagline (used by posts for the description). */
  lede?: string;
  /** Extra JSON-LD nodes appended to the Person + WebSite graph (R3). */
  jsonLd?: JsonLdNode[];
  /** Social profile links in the hero — home page only, to avoid repetition. */
  showSocial?: boolean;
  /**
   * Keeps a page out of search results while leaving it reachable by URL.
   * Used by tailored resume variants (src/lib/resume.ts explains why this,
   * and not a robots.txt Disallow, is the mechanism that works).
   */
  noindex?: boolean;
}

const {
  title,
  description,
  heading,
  tagline,
  lede,
  jsonLd = [],
  showSocial = false,
  noindex = false,
} = Astro.props;

// R1.4 — exactly one canonical per page, always absolute. Derived from
// `site` + the current path so it cannot drift from the sitemap.
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

const ogTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{ogTitle}</title>
    <meta name="description" content={description} />
    <!-- Mobile browser chrome matches the page instead of flashing white. -->
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    {
      /*
       * `noarchive` alongside `noindex` matters here: without it a search
       * engine that has already fetched an unlisted page can keep serving a
       * cached copy of it after it drops out of the index.
       */
      noindex && <meta name="robots" content="noindex, nofollow, noarchive" />
    }

    <link rel="icon" href="/assets/img/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <!-- /feed.xml, not /rss.xml — preserves the jekyll-feed URL. -->
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />

    {/*
      R7.1 — there is no webfont, and so no external request of any kind: the
      page is now self-contained apart from its own CSS. The type stack is
      declared in global.css (`--font-mono`). Nothing to preconnect to, no
      swap-in reflow, no third-party dependency in the critical path.
    */}

    <JsonLd nodes={jsonLd} />

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {/*
      R2.2 — real landmark elements throughout, not generic divs. There is
      deliberately no nav landmark: the site is a blog index plus its posts, so
      every link a navbar would hold is either the page you are on or already
      in the post list. A nav wrapping a single self-link is noise for
      screen-reader users, not orientation. The skip link stays — it is now the
      only bypass mechanism, and verify.mjs checks its target resolves.
    */}
    <header class="site-header">
      <Image
        class="site-header__bg"
        src={hero}
        alt=""
        widths={[768, 1280, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        layout="none"
      />

      <div class="container">
        <h1>{heading}</h1>
        {tagline && <p class="site-header__tagline">{tagline}</p>}
        {lede && <p class="site-header__description">{lede}</p>}
        <slot name="hero-meta" />
        {showSocial && <SocialLinks />}
      </div>
    </header>

    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <SocialLinks />
        <!--
          The only in-site link outside the post index. It is in the footer
          rather than a nav for the reason given above — one link is not
          navigation — but it does need to exist somewhere crawlable, because
          a page reachable only from the sitemap is a page nothing links to.
        -->
        <p><a class="footer-cta" href="/resume/">resume</a></p>
        <p>
          &copy; {new Date().getFullYear()} Russell Sherman. Built with{' '}
          <a href="https://astro.build">Astro</a>.
        </p>
        <p>
          <!--
            R4.3 — llms.txt must be linked from at least one crawled page,
            not only listed in the sitemap. The footer puts it on every page.
          -->
          <a href="/llms.txt">llms.txt</a>{' · '}<a href="/llms-full.txt">llms-full.txt</a>{
            ' · '
          }<a href="/feed.xml">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>
